{
  "expo": {
    "name": "Diário de Rotas",
    "slug": "diario-rotas",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "diariorotas",
    "userInterfaceStyle": "light",
    "android": {
      "package": "br.fatec.diariorotas",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A localização é usada para registrar o percurso da rota."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "A câmera é usada para adicionar uma foto ao seu perfil.",
          "photosPermission": "As fotos são usadas para escolher uma imagem para o seu perfil.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
